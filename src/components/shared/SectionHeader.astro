---
import type { SectionHeaderInterface } from './interfaces'
import Link from '@components/primitives/Link.astro'
import Label from './Label.astro'

interface Props extends SectionHeaderInterface {}

const { label, title, action } = Astro.props
---

<div class="section-header-container">
  <div class="section-header">
    <Label label={label} />
    <span class="title-section">{title}</span>
  </div>
  {action === undefined ? (
    <span></span>
  ) : (
    <Link link={action} type="internal" />
  )}
</div>
