---
import { ICON_SIZE } from '@components/shared/icon-sizes'
import type { ProjectRowInterface } from '@components/shared/interfaces'
import { MoveRight } from '@lucide/astro'

interface Props extends ProjectRowInterface {}

const { name, kind, stack, year, slug } = Astro.props
---

<a href={`/projects/${slug}/`} class="project-row-container">
  <span class="project-name">{name}</span>
  <div class="project-info">
    <span class="project-kind">{kind}</span>
    <div class="project-stack">
      {stack.map((stack) => (
        <span>{stack}</span>
      ))}
    </div>
  </div>
  <span class="project-year">
    {year} <MoveRight class="year-icon" size={ICON_SIZE.xs} />
  </span>
</a>
