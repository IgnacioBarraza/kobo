---
import { ICON_SIZE } from '@components/shared/icon-sizes'
import { MoveRight } from '@lucide/astro'

interface Props {
  projectName: string
  projectKind: string
  projectStack: string[]
  projectYear: string
  projectSlug: string
}

const { projectName, projectKind, projectStack, projectYear, projectSlug } =
  Astro.props
---

<a href={`/projects/${projectSlug}/`} class="project-row-container">
  <span class="project-name">{projectName}</span>
  <div class="project-info">
    <span class="project-kind">{projectKind}</span>
    <div class="project-stack">
      {projectStack.map((stack) => (
        <span>{stack}</span>
      ))}
    </div>
  </div>
  <span class="project-year">
    {projectYear} <MoveRight class="year-icon" size={ICON_SIZE.xs} />
  </span>
</a>
