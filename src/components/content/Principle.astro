---
import type { PrinciplesInterface } from '@components/shared/interfaces'

interface Props extends PrinciplesInterface {}

const { item, name, description, divider } = Astro.props
---

<div class="principle-container">
  <div class="principle">
    <span class="principle-item">{item}</span>
    <span class="principle-name">{name}</span>
    <span class="principle-desc">{description}</span>
  </div>
  {divider ? <div class="principle-divisor"></div> : <div></div>}
</div>
