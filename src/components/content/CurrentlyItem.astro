---
import type { CurrentlyInterface } from '@components/shared/interfaces'

interface Props extends CurrentlyInterface {}

const { label, values } = Astro.props
---

<div class="currently-item-container">
  <span class="currently-label">{label}</span>
  {values.map((value) => (
    <span class="currently-value">{value}</span>
  ))}
</div>
