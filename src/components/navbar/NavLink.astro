---
import type { NavLinkInterface } from '@components/shared/interfaces'

interface Props extends NavLinkInterface {}

const { link, currentPath } = Astro.props

const normalizePath = (path: string) => {
  if (path === '/') return path

  return path.replace(/\/+$/, '')
}

const isActive = normalizePath(currentPath) === normalizePath(link.href)
---

<a
  href={link.href}
  class:list={['nav-link', { active: isActive }]}
  aria-current={isActive ? 'page' : undefined}
>
  <span>{link.label}</span>
</a>
