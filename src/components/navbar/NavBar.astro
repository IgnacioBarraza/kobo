---
import NavLink from './NavLink.astro'
import ThemeToggle from './ThemeToggle.astro'
import PaletteTrigger from '@components/primitives/PaletteTrigger.astro'
import Kbd from '@components/primitives/Kbd.astro'
import { NavLinks } from '../../data/links'

const currentPath = Astro.url.pathname
---

<div class="nav-container">
  <a href="/" class="kobo-brand">
    <span class="kobo-main">Kōbō</span>
    <span class="kobo-secondary">工房</span>
  </a>
  <nav class="nav-bar">
    {NavLinks.map((link) => (
      <NavLink link={link} currentPath={currentPath} />
    ))}
  </nav>
  <div class="nav-action-btns">
    <PaletteTrigger>
      <Kbd />
    </PaletteTrigger>
    <ThemeToggle />
  </div>
</div>
