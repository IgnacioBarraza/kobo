---
import type {
  CurrentlyInterface,
  ExperienceEntryInterface,
  LinkInterface,
  PrinciplesInterface,
  ProjectsInterface,
  SectionHeaderInterface
} from '@components/shared/interfaces'
import BaseLayout from '../layouts/BaseLayout.astro'
import Link from '@components/primitives/Link.astro'
import { siteConfig } from '@config'
import SectionHeader from '@components/shared/SectionHeader.astro'
import { Projects } from '../data/projects'
import ProjectRow from '@components/content/ProjectRow.astro'
import { Site } from '../data/kobo'
import { MediaLinks } from '../data/links'
import Principle from '@components/content/Principle.astro'
import ExperienceEntry from '@components/content/ExperienceEntry.astro'
import CurrentlyItem from '@components/content/CurrentlyItem.astro'
import Label from '@components/shared/Label.astro'

const link: LinkInterface[] = [
  {
    label: 'Explore projects',
    href: '/projects/'
  },
  {
    label: 'About me',
    href: '/about/'
  }
]

const featuredProjectSection: SectionHeaderInterface = {
  label: '03 / SELECTED PROJECTS',
  title: 'Selected work',
  action: {
    label: 'View all',
    href: '/projects/'
  }
}

const experienceSection: SectionHeaderInterface = {
  label: '05 / EXPERIENCE',
  action: {
    label: 'View experience',
    href: '/experience/'
  }
}

const principles: PrinciplesInterface[] = [
  {
    item: 'i',
    name: 'Clarity',
    description: 'Make complexity understandable.',
    divider: true
  },
  {
    item: 'ii',
    name: 'Craft',
    description: 'Build with intention.',
    divider: true
  },
  {
    item: 'iii',
    name: 'Improvement',
    description: 'Keep learning, keep refining.',
    divider: false
  }
]

const experienceEntry: ExperienceEntryInterface[] = [
  {
    period: '2024 - NOW',
    role: 'Full Stack Developer',
    company: 'MapVx',
    stack: [
      'Node.js',
      'TypeScript',
      'Express',
      'PostgreSQL',
      'TypeORM',
      'Redis',
      'BullMQ',
      'AWS',
      'Docker',
      'Angular'
    ]
  },
  {
    period: '2023 - 2024',
    role: 'Front End Developer',
    company: 'MapVx',
    stack: ['Angular', 'TypeScript', 'RxJS', 'Firebase', 'Bootstrap']
  },
  {
    period: 'Mar 2024 - Dec 2024',
    role: 'Teaching Assistant – Engineering',
    company: 'Universidad de Tarapacá'
  }
]

const selectedProjects: ProjectsInterface[] = Projects

const currently: CurrentlyInterface[] = [
  {
    label: 'BUILDING',
    values: ['Kōbō']
  },
  {
    label: 'LEARNING',
    values: ['Japanese', 'AWS']
  },
  {
    label: 'EXPLORING',
    values: ['Robotics', 'Cloud Systems', 'Distributed Systems']
  }
]

const letsBuildLinks: LinkInterface[] = [
  {
    label: "Let's talk",
    href: '/contact/'
  },
  ...MediaLinks
]
---

<BaseLayout>
  <div class="home-container">
    <section class="software-engineer-section">
      <div class="grid">
        <div class="hero-body">
          <Label label="01 / SOFTWARE ENGINEER" />
          <h1 class="hero-headline">Building things with intention.</h1>
          <p class="hero-name">Ignacio Barraza</p>
          <p class="hero-desc">{siteConfig.description}</p>
          <Link link={link[0]} type="internal" />
        </div>
        <aside class="hero-aside">
          <div class="vertical-line"></div>
          <div class="aside-info">
            <span class="kobo-brand">工房 · kōbō</span>
            <span class="kobo-workshop">Workshop · atelier</span>
            <span class="kobo-location">Iquique, Chile · UTC-3</span>
          </div>
        </aside>
      </div>
    </section>
    <div class="separation-line"></div>
    <section class="introduction-section">
      <div class="grid">
        <div class="introduction-body">
          <Label label="02 / INTRODUCTION" />
          <p class="introduction-desc">
            I'm Ignacio, a software engineer from Chile who enjoys turning
            complex problems into simple, maintainable software.
          </p>
          <p class="introduction-desc-secondary">
            I work across the stack, with a particular interest in backend
            systems, architecture, and developer tooling.
          </p>
          <Link link={link[1]} type="internal" />
        </div>
      </div>
    </section>
    <div class="separation-line"></div>
    <section class="featured-projects-section">
      <SectionHeader
        label={featuredProjectSection.label}
        title={featuredProjectSection.title}
        action={featuredProjectSection.action}
      />
      <div class="project-row-component"></div>
      <div class="separation-line"></div>
      {selectedProjects.map((project) => (
        <ProjectRow
          name={project.name}
          kind={project.kind}
          stack={project.general_stack}
          year={project.year}
          slug={project.slug}
        />
      ))}
    </section>
    <div class="separation-line"></div>
    <section class="philosophy-section">
      <Label label="04 / ENGINEERING PHILOSOPHY" />
      <div class="philosophy-grid">
        <p class="philosophy-statement">{Site.tagline}</p>
        <p class="philosophy-support">
          I care about software that is easy to understand, maintain, and evolve
          — not just software that works.
        </p>
      </div>
      <div class="separation-line"></div>
      <div class="principle-component">
        {principles.map((principle, index) => (
          <Principle
            item={principle.item}
            name={principle.name}
            description={principle.description}
            divider={principle.divider}
          />
        ))}
      </div>
    </section>
    <div class="separation-line"></div>
    <section class="experience-section">
      <SectionHeader
        label={experienceSection.label}
        action={experienceSection.action}
      />
      <div class="experience-component">
        <div class="separation-line"></div>
        {experienceEntry.map((entry) => (
          <ExperienceEntry
            period={entry.period}
            role={entry.role}
            company={entry.company}
            stack={entry.stack}
          />
        ))}
      </div>
    </section>
    <div class="separation-line"></div>
    <section class="currently-section">
      <Label label="06 / CURRENTLY" />
      <div class="separation-line"></div>
      <div class="currently-items">
        {currently.map((item) => (
          <CurrentlyItem label={item.label} values={item.values} />
        ))}
      </div>
      <Label label="LAST UPDATED · NOVEMBER 2026" />
    </section>
    <div class="separation-line"></div>
    <section class="lets-build-section">
      <Label label="07 / LET'S BUILD" />
      <p class="lets-build-title">Have something worth building?</p>
      <div class="lets-build-links">
        {letsBuildLinks.map((link) => (
          <Link
            link={link}
            type={link.label === "Let's talk" ? 'internal' : 'external'}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
